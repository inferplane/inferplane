#!/usr/bin/env python3
"""Probe one declared gateway route with synthetic text and a durable cost limit.

A success proves an observed lower bound, not the maximum or model quality.
Unknown errors/usage retain the full pre-call reservation. No transport retries.
"""

import argparse
from decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN, ROUND_HALF_UP
import fcntl
import json
import os
from pathlib import Path
import re
import sys
import time
import urllib.error
import urllib.request


BASE_URL = "http://127.0.0.1:8080/v1"
MAX_RESPONSE = 8 * 1024 * 1024


def gateway_base_url():
    port = os.environ.get("INFERPLANE_PORT") or "8080"
    if len(port) > 5 or not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
        raise ValueError("invalid local gateway port")
    return "http://127.0.0.1:{}/v1".format(int(port))


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def micros(value):
    value = Decimal(str(value))
    if not value.is_finite() or value < 0:
        raise ValueError("invalid price")
    return int((value * 1000000).to_integral_value(rounding=ROUND_HALF_UP))


def rates(config):
    base = Decimal(str(config.get("input_per_mtok", 0)))
    output = Decimal(str(config.get("output_per_mtok", 0)))
    if not base.is_finite() or not output.is_finite() or base < 0 or output < 0:
        raise ValueError("invalid price")
    if base == output == 0 and config.get("free") is not True:
        raise ValueError("unpriced route")
    read = Decimal(str(config.get("cache_read_per_mtok", 0))) or base / 10
    unsupported = config.get("cache_write_unsupported", False)
    write5 = Decimal(0) if unsupported else Decimal(str(config.get("cache_write_5m_per_mtok", 0))) or base * Decimal("1.25")
    write1 = Decimal(0) if unsupported else Decimal(str(config.get("cache_write_1h_per_mtok", 0))) or base * 2
    result = {"input": micros(base), "output": micros(output), "read": micros(read),
              "write": max(micros(write5), micros(write1)), "write_unsupported": unsupported}
    if "long_context" in config or "short_context_limit" in config:
        limit = config.get("short_context_limit")
        long = config.get("long_context")
        if (type(limit) is not int or limit <= 0 or not isinstance(long, dict)
                or "long_context" in long or "short_context_limit" in long):
            raise ValueError("invalid context pricing")
        result.update(short_context_limit=limit, long_context=rates(long))
    return result


def reserve_micros(request_bytes, output_limit, rate):
    # One token per serialized UTF-8 byte conservatively bounds this synthetic
    # ASCII prompt. Reserve the highest input/cache class with upward rounding.
    candidates = [rate, rate["long_context"]] if "long_context" in rate else [rate]
    input_price = max(r[key] for r in candidates for key in ("input", "read", "write"))
    output_price = max(r["output"] for r in candidates)
    numerator = request_bytes * input_price + output_limit * output_price
    return (numerator + 999999) // 1000000


def usage_cost(usage, rate, output_limit):
    if not isinstance(usage, dict):
        return None
    details = usage.get("input_tokens_details") or {}
    if not isinstance(details, dict):
        return None
    counts = [usage.get("input_tokens"), usage.get("output_tokens"),
              details.get("cached_tokens", 0), details.get("cache_write_tokens", 0)]
    if any(type(n) is not int or n < 0 for n in counts):
        return None
    inp, out, cached, write = counts
    if cached + write > inp or out > output_limit:
        return None
    if "long_context" in rate and inp > rate["short_context_limit"]:
        rate = rate["long_context"]
    if write and rate.get("write_unsupported"):
        return None
    return sum(int((Decimal(n * price) / 1000000).to_integral_value(rounding=ROUND_HALF_EVEN))
               for n, price in [(inp - cached - write, rate["input"]), (out, rate["output"]),
                                (cached, rate["read"]), (write, rate["write"])])


def classify(status, body):
    error = body.get("error", {}) if isinstance(body, dict) else {}
    if status == 400 and isinstance(error, dict) and error.get("code") == "context_length_exceeded":
        return "context_refusal"
    if status in (401, 403):
        return "auth_or_policy_refusal"
    if status == 429:
        return "rate_or_quota_refusal"
    if status == 413:
        return "body_limit_refusal"
    return "rejected_unclassified"


def payload(model, units, mode, output_limit):
    body = {"model": model, "instructions": "This is a synthetic capacity test. Reply only OK, without tools or reasoning.",
            "input": " a" * units, "max_output_tokens": output_limit, "store": False}
    if mode == "bridge":
        body["reasoning"] = {"effort": "none"}
    return body


def write_ledger(file, records):
    file.seek(0)
    json.dump(records, file, indent=2)
    file.truncate()
    file.flush()
    os.fsync(file.fileno())


def probe(opener, key, raw, record, rate, output_limit, *, expected_model=None):
    req = urllib.request.Request(BASE_URL + "/responses", data=raw,
                                 headers={"Authorization": "Bearer " + key, "Content-Type": "application/json"})
    started = time.monotonic()
    try:
        try:
            with opener.open(req, timeout=240) as response:
                status, body = response.status, response.read(MAX_RESPONSE + 1)
                headers = response.headers
        except urllib.error.HTTPError as error:
            status, body = error.code, error.read(MAX_RESPONSE + 1)
            headers = error.headers
        substituted = any(headers.get(name) for name in (
            "x-inferplane-substituted-model", "x-inferplane-fallback",
            "x-inferplane-model-fallback", "x-inferplane-routed-model",
        ))
        record["http_status"] = status
        if len(body) > MAX_RESPONSE:
            raise ValueError()
        result = json.loads(body)
        cost = usage_cost(result.get("usage"), rate, output_limit) if isinstance(result, dict) else None
        if status // 100 == 2 and cost is not None:
            record.update(state="accepted" if not substituted and result.get("model") == (expected_model or record["model"]) else "substituted_unqualified",
                          input_tokens=result["usage"]["input_tokens"], output_tokens=result["usage"]["output_tokens"])
            # Even unexpected over-usage must never lower a held reservation.
            if cost <= record["reserved_micro_usd"]:
                record["held_micro_usd"] = cost
            else:
                record["state"] = "cost_bound_breach"
                record["held_micro_usd"] = cost
        elif status // 100 == 2:
            record["state"] = "usage_uncertain"
        else:
            record["state"] = classify(status, result)
    except (OSError, ValueError, urllib.error.URLError):
        record["state"] = "transport_or_response_uncertain"
    finally:
        record["elapsed_seconds"] = round(time.monotonic() - started, 3)


def main():
    global BASE_URL
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True, help="local gateway declaration; secrets are not resolved")
    parser.add_argument("--model", required=True)
    parser.add_argument("--units", required=True, type=int, help="synthetic ' a' repetitions, not an asserted token count")
    parser.add_argument("--max-spend-usd", required=True)
    parser.add_argument("--ledger", required=True, help="persisted ledger shared by every probe in this campaign")
    parser.add_argument("--execute", action="store_true", help="actually invoke the paid API; otherwise print the plan")
    args = parser.parse_args()
    try:
        if "INFERPLANE_PORT" in os.environ:
            BASE_URL = gateway_base_url()
        if not 0 < args.units <= 8 * 1024 * 1024:
            raise ValueError("units must be between 1 and 8388608")
        budget = micros(args.max_spend_usd)
        if budget <= 0:
            raise ValueError("budget must be positive")
        cfg = json.loads(Path(args.config).read_text(), parse_float=Decimal)
        model = cfg["models"][args.model]
        if len(model["targets"]) != 1:
            raise ValueError("qualification requires exactly one configured target")
        target = model["targets"][0]
        provider = cfg["providers"][target["provider"]]
        declared_rates = cfg.get("pricing", {}).get("overrides", {}).get(target["provider"], {})
        base = re.sub(r"^(global|us|eu|apac|us-gov)\.", "", target["model"])
        rate = rates(declared_rates.get(target["model"], declared_rates.get(base, {})))
        mode = "native" if provider["type"] in ("bedrock_responses", "openai_responses") else "bridge"
        output_limit = 128
        raw = json.dumps(payload(args.model, args.units, mode, output_limit), separators=(",", ":")).encode()
        reserve = reserve_micros(len(raw), output_limit, rate)
        record = {"model": args.model, "declared_context": model["context_window"],
                  "synthetic_units": args.units, "request_bytes": len(raw),
                  "reserved_micro_usd": reserve, "held_micro_usd": reserve, "state": "started",
                  "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        if not args.execute:
            record["state"] = "plan_only"
            print(json.dumps(record))
            return 0
        key = os.environ.get("INFERPLANE_API_KEY", "")
        if not key or any(ord(c) <= 32 or ord(c) >= 127 for c in key):
            raise ValueError("set INFERPLANE_API_KEY privately before execution")
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect())
        discovery = urllib.request.Request(BASE_URL + "/models", headers={"Authorization": "Bearer " + key})
        with opener.open(discovery, timeout=5) as response:
            catalog_raw = response.read(4 * 1024 * 1024 + 1)
        if len(catalog_raw) > 4 * 1024 * 1024:
            raise ValueError("oversized model catalog")
        catalog = json.loads(catalog_raw)
        live = next(m for m in catalog["data"] if m["id"] == args.model)
        if live.get("context_window") != record["declared_context"] or live.get("responses_mode") != mode:
            raise ValueError("live gateway metadata differs from the local probe declaration")
        # Hold the lock across the call: concurrent processes cannot each spend
        # the same remaining budget. A crashed started record remains held.
        fd = os.open(args.ledger, os.O_RDWR | os.O_CREAT, 0o600)
        with os.fdopen(fd, "r+") as file:
            fcntl.flock(file, fcntl.LOCK_EX)
            previous = file.read()
            records = json.loads(previous) if previous else []
            if not isinstance(records, list) or any(not isinstance(r, dict) or type(r.get("held_micro_usd")) is not int or r["held_micro_usd"] < 0 for r in records):
                raise ValueError("invalid campaign ledger")
            if sum(r["held_micro_usd"] for r in records) + reserve > budget:
                raise ValueError("campaign budget exhausted; unknown calls remain reserved")
            records.append(record)
            write_ledger(file, records)
            print(json.dumps(record), flush=True)
            probe(opener, key, raw, record, rate, output_limit,
                  expected_model=target["model"] if mode == "native" else args.model)
            write_ledger(file, records)
            print(json.dumps(record), flush=True)
        return 0 if record["state"] == "accepted" else 1
    except (OSError, ValueError, InvalidOperation, KeyError, TypeError, StopIteration, urllib.error.URLError):
        # Do not echo exception text: URLs, submitted IDs and upstream bodies
        # may contain credential or input material.
        print("context probe refused: check configuration, metadata, prices, ledger and budget", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
