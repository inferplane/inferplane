{
  "server": {
    "listen": ":8080",
    "admin_listen": ":9090",
    "drain_grace": "10s",
    "admin_auth": {
      "token_refs": [
        {
          "env": "INFERPLANE_ADMIN_TOKEN"
        }
      ]
    }
  },
  "key_store": {
    "type": "sqlite",
    "path": "/var/lib/inferplane/keys.db"
  },
  "audit": {
    "failure_mode": "buffer_then_block",
    "buffer": {
      "path": "/var/lib/inferplane/audit.wal"
    },
    "sinks": [
      {
        "type": "stdout"
      },
      {
        "type": "file",
        "path": "/var/lib/inferplane/audit.jsonl"
      }
    ]
  },
  "providers": {
    "bedrock-seoul": {
      "type": "bedrock",
      "region": "ap-northeast-2",
      "auth": {
        "mode": "irsa"
      }
    }
  },
  "models": {
    "global.anthropic.claude-opus-5-5": {
      "context_window": 1000000,
      "targets": [
        {
          "provider": "bedrock-seoul",
          "model": "global.anthropic.claude-opus-5-5",
          "api": "invoke_model"
        }
      ],
      "capabilities": [
        "tools"
      ]
    }
  },
  "teams": {
    "demo": {
      "allowed_models": [
        "global.anthropic.claude-opus-5-5"
      ],
      "rate_limit": {
        "requests_per_minute": 120
      }
    }
  },
  "pricing": {
    "on_missing": "block",
    "version": "aws-opus-5-5-global-standard-2026-09-23",
    "overrides": {
      "bedrock-seoul": {
        "global.anthropic.claude-opus-5-5": {
          "input_per_mtok": 4,
          "output_per_mtok": 20,
          "cache_read_per_mtok": 0.2,
          "cache_write_5m_per_mtok": 5,
          "cache_write_1h_per_mtok": 8
        }
      }
    }
  },
  "_comment_pricing": "Standard Global USD per million tokens from AmazonBedrockFoundationModels ap-northeast-2, checked 2026-09-23. Cache read is $0.20 (0.05x input, NOT the default 0.1x). Exact profile prices prevent inheritance by US CRIS.",
  "_comment_opus": "Uses the EC2 instance role via the default SDK credential chain, not samples. Global routing is not Korean residency. Thinking is always on: thinking.type disabled and enabled+budget_tokens both 400 (the Bedrock legacy-thinking adapter rewrites only the budget_tokens form). Default effort is medium; set output_config.effort explicitly. Forced tool_choice any/tool returns 400, so OpenAI tool_choice required is rejected upstream."
}
